{
  "name": "@speclynx/apidom-parser",
  "version": "7.1.0",
  "description": "Parser consumes parser adapters and provides unified API for parsing.",
  "keywords": [
    "apidom",
    "api",
    "parser",
    "parse",
    "openapi",
    "swagger",
    "oas",
    "asyncapi",
    "arazzo",
    "json-schema",
    "json",
    "yaml",
    "ast",
    "detect",
    "spec",
    "specification",
    "typescript",
    "javascript"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "provenance": true,
    "timeout": 60000
  },
  "type": "module",
  "sideEffects": false,
  "unpkg": "./dist/apidom-parser.browser.min.js",
  "main": "./src/parser.cjs",
  "exports": {
    "import": {
      "types": "./types/apidom-parser.d.ts",
      "default": "./src/parser.mjs"
    },
    "require": {
      "types": "./types/apidom-parser.d.cts",
      "default": "./src/parser.cjs"
    }
  },
  "types": "./types/apidom-parser.d.ts",
  "scripts": {
    "build": "npm run clean && run-p --max-parallel ${CPU_CORES:-2} typescript:declaration build:es build:cjs build:umd:browser",
    "build:es": "cross-env BABEL_ENV=es babel src --out-dir src --extensions '.ts' --out-file-extension '.mjs' --root-mode 'upward'",
    "build:cjs": "cross-env BABEL_ENV=cjs babel src --out-dir src --extensions '.ts' --out-file-extension '.cjs' --root-mode 'upward'",
    "build:umd:browser": "cross-env BABEL_ENV=browser webpack --config config/webpack/browser.config.js --progress",
    "lint": "eslint ./",
    "lint:fix": "eslint ./ --fix",
    "clean": "rimraf --glob 'src/**/*.mjs' 'src/**/*.cjs' 'test/**/*.mjs' ./dist ./types",
    "typescript:check-types": "tsc --noEmit",
    "typescript:declaration": "tsc -p tsconfig.declaration.json && api-extractor run -l -c ./config/api-extractor/api-extractor.json && node ../../scripts/declarations-cts.mjs types/apidom-parser.d.ts",
    "typescript:check-published-types": "attw --pack . --profile node16",
    "test": "npm run build:es && cross-env BABEL_ENV=es babel test --out-dir test --extensions '.ts' --out-file-extension '.mjs' --root-mode 'upward' && cross-env NODE_ENV=test mocha",
    "prepack": "copyfiles -u 3 ../../LICENSES/* LICENSES && copyfiles -u 2 ../../NOTICE .",
    "postpack": "rimraf NOTICE LICENSES"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/speclynx/apidom.git"
  },
  "author": "Vladimir Gorej",
  "license": "Apache-2.0",
  "dependencies": {
    "@babel/runtime-corejs3": "^8.1.3",
    "@speclynx/apidom-core": "7.1.0",
    "@speclynx/apidom-datamodel": "7.1.0",
    "@speclynx/apidom-error": "7.1.0",
    "@swaggerexpert/media-types": "^1.0.3",
    "ramda": "~0.32.0",
    "ramda-adjunct": "^6.1.0"
  },
  "files": [
    "src/**/*.mjs",
    "src/**/*.cjs",
    "dist/",
    "types/apidom-parser.d.ts",
    "types/apidom-parser.d.cts",
    "LICENSES",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ]
}
