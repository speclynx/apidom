@@ -1354,16 +1355,27 @@ static bool scan(Scanner *scanner, TSLexer *lexer, const bool *valid_symbols) {
             if (lexer->lookahead == 0 || !is_nwl(lexer->lookahead)) {
                 break;
             }
+            // a tab doesn't count as indentation, so a line that starts with spaces only up to the
+            // current indentation and then a tab doesn't continue the scalar (YAML 1.2 §6.1)
+            bool has_tab = false;
+            int16_t lead_spc = 0;
             for (;;) {
                 if (is_nwl(lexer->lookahead)) {
                     adv_nwl(scanner, lexer);
+                    has_tab = false;
+                    lead_spc = 0;
                 } else if (is_wsp(lexer->lookahead)) {
+                    if (lexer->lookahead == '\t') {
+                        has_tab = true;
+                    } else if (!has_tab) {
+                        lead_spc++;
