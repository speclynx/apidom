                     adv(scanner, lexer);
                 } else {
                     break;
                 }
             }
-            if (lexer->lookahead == 0 || scanner->cur_col <= cur_ind) {
+            if (lexer->lookahead == 0 || scanner->cur_col <= cur_ind || (has_tab && lead_spc <= cur_ind)) {
